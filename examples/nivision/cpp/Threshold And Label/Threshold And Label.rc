// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\Threshold And Label.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_THRESHOLDANDLABEL_DIALOG DIALOGEX 0, 0, 320, 200
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Threshold And Label Example"
FONT 8, "MS Sans Serif"
BEGIN
    RTEXT           "Choose an Image to Process",IDC_STATIC,7,22,107,10
    PUSHBUTTON      "Load Image",IDC_BROWSE,122,20,72,14
    CTEXT           "Histogram of Source Image",IDC_STATIC,13,46,227,9
    CONTROL         "",IDC_HISTOGRAM,"Static",SS_ENHMETAFILE | SS_NOTIFY | 
                    SS_SUNKEN | WS_BORDER,13,58,227,97
    CONTROL         "Connectivity 4",IDC_CONNECTIVITY_4,"Button",
                    BS_AUTORADIOBUTTON | BS_LEFTTEXT,248,82,65,15
    CONTROL         "Connectivity 8",IDC_CONNECTIVITY_8,"Button",
                    BS_AUTORADIOBUTTON | BS_LEFTTEXT,248,97,65,15
    LTEXT           "Threshold Range",IDC_STATIC,246,145,67,10
    CONTROL         "Slider1",IDC_THRESH_MIN,"msctls_trackbar32",TBS_BOTH | 
                    TBS_NOTICKS | WS_TABSTOP,7,155,238,14,WS_EX_TRANSPARENT
    LTEXT           "100",IDC_THRESH_MIN_DISPLAY,247,156,20,9
    CONTROL         "Slider1",IDC_THRESH_MAX,"msctls_trackbar32",TBS_BOTH | 
                    TBS_NOTICKS | WS_TABSTOP,7,168,238,14,WS_EX_TRANSPARENT
    LTEXT           "100",IDC_THRESH_MAX_DISPLAY,247,170,20,9
    CTEXT           "Particle Count: 100",IDC_PARTICLE_COUNT,13,181,227,12
    PUSHBUTTON      "Quit",IDCANCEL,263,179,50,14
END


