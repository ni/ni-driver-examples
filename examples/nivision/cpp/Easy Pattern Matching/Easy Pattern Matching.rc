// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\Easy Pattern Matching.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_EASYPATTERNMATCHING_DIALOG DIALOGEX 1, 1, 320, 143
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Easy Pattern Matching Example"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "Do Search",ID_DO_SEARCH,7,83,78,14,WS_DISABLED
    PUSHBUTTON      "Quit",IDCANCEL,263,122,50,14
    DEFPUSHBUTTON   "Load Images",ID_LOAD_IMAGES,7,31,78,14
    DEFPUSHBUTTON   "Learn Template",ID_LEARN_TEMPLATE,7,57,78,14,
                    WS_DISABLED
    GROUPBOX        "Match Options",IDC_STATIC,109,14,180,71
    CONTROL         "Rotation Invariance",IDC_ROTATION_INVARIANCE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,116,28,124,15
    EDITTEXT        IDC_MATCH_SCORE,116,46,32,12,ES_AUTOHSCROLL
    LTEXT           "Match Score",IDC_STATIC,152,48,67,10
    EDITTEXT        IDC_MAX_MATCHES,116,65,32,12,ES_AUTOHSCROLL
    LTEXT           "Maximum Number of Matches",IDC_STATIC,152,67,132,10
    LTEXT           "Learning.  This may take up to 20 seconds.",
                    IDC_LEARNING_TEXT,109,93,156,10,NOT WS_VISIBLE
    LTEXT           "Matches Found: 10",IDC_MATCHES_TEXT,109,106,115,8
END


