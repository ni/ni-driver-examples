// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\Load And Display.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_LOADANDDISPLAY_DIALOG DIALOGEX 0, 0, 290, 110
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Load And Display Example"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_FILENAME,81,48,95,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Browse",IDB_BROWSE,181,47,50,14
    DEFPUSHBUTTON   "Load Image",IDB_LOAD,83,82,50,14
    PUSHBUTTON      "Quit",IDCANCEL,169,82,50,14
    CTEXT           "Choose A File To Display Then Press Load Image",
                    IDC_STATIC,7,22,276,13
END


