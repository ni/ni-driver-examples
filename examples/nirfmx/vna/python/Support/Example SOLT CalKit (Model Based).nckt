			<Description>Example Load</Description>
			<FrequencyRange>
				<Min>1000000000</Min>
				<Max>99000000000</Max>
			</FrequencyRange>
			<RoutedPort>
				<PhysicalPortId>Load-F_Port0</PhysicalPortId>
				<SParameterPortIndex>0</SParameterPortIndex>
			</RoutedPort>
			<ElementTypes>
				<Type>Load</Type>
			</ElementTypes>
			<ReflectModel>
				<ModelType>Load</ModelType>
				<SParameterAvailability>Known</SParameterAvailability>
				<Delay>0</Delay>
				<OffsetLoss>0</OffsetLoss>
				<OffsetZ0>50</OffsetZ0>
				<C0>0</C0>
				<C1>0</C1>
				<C2>0</C2>
				<C3>0</C3>
				<ReferenceZ0>0</ReferenceZ0>
			</ReflectModel>
		</CalibrationElement>
		<CalibrationElement>
			<Id>Thru-M-M</Id>
			<Description>Example Thru</Description>
			<FrequencyRange>
				<Min>1000000000</Min>
				<Max>99000000000</Max>
			</FrequencyRange>
			<RoutedPort>
				<PhysicalPortId>Thru-M-M_Port0</PhysicalPortId>
				<SParameterPortIndex>0</SParameterPortIndex>
			</RoutedPort>
			<RoutedPort>
				<PhysicalPortId>Thru-M-M_Port1</PhysicalPortId>
				<SParameterPortIndex>1</SParameterPortIndex>
			</RoutedPort>
			<ElementTypes>
				<Type>Thru</Type>
			</ElementTypes>
			<DelayModel>
				<MinDelay>1E-11</MinDelay>
				<MaxDelay>1E-11</MaxDelay>
			</DelayModel>
