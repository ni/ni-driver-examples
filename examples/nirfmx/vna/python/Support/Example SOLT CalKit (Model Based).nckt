<?xml version="1.0" encoding="utf-8"?>
<CalibrationKit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="NICalKitFile">
	<Id>Example SOLT CalKit (Model Based)</Id>
	<FileVersion>1.0.0</FileVersion>
	<Description>Example SOLT Calkit</Description>
	<ConnectorList>
		<Connector>
			<Id>3.5mm-Male</Id>
			<Description>Connector Description</Description>
			<Type>3.5mm</Type>
			<Gender>Male</Gender>
			<FrequencyRange>
				<Min>0</Min>
				<Max>100000000000</Max>
			</FrequencyRange>
			<ImpedanceZ0>50</ImpedanceZ0>
		</Connector>
		<Connector>
			<Id>3.5mm-Female</Id>
			<Description>Connector Description</Description>
			<Type>3.5mm</Type>
			<Gender>Female</Gender>
			<FrequencyRange>
				<Min>0</Min>
				<Max>100000000000</Max>
			</FrequencyRange>
			<ImpedanceZ0>50</ImpedanceZ0>
		</Connector>
	</ConnectorList>
	<PhysicalPortList>
		<ConnectorizedPort>
			<Id>Short-M_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Male</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Short-F_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Female</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Open-M_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Male</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Open-F_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Female</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Load-M_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Male</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Load-F_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Female</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Thru-M-M_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Male</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Thru-M-M_Port1</Id>
			<Description />
			<ConnectorId>3.5mm-Male</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Thru-F-F_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Female</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Thru-F-F_Port1</Id>
			<Description />
			<ConnectorId>3.5mm-Female</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Thru-M-F_Port0</Id>
			<Description />
			<ConnectorId>3.5mm-Male</ConnectorId>
		</ConnectorizedPort>
		<ConnectorizedPort>
			<Id>Thru-M-F_Port1</Id>
			<Description />
			<ConnectorId>3.5mm-Female</ConnectorId>
		</ConnectorizedPort>
	</PhysicalPortList>
	<CalibrationElementList>
		<CalibrationElement>
			<Id>Short-M</Id>
			<Description>Example Short</Description>
			<FrequencyRange>
				<Min>1000000000</Min>
				<Max>99000000000</Max>
			</FrequencyRange>
			<RoutedPort>
				<PhysicalPortId>Short-M_Port0</PhysicalPortId>
				<SParameterPortIndex>0</SParameterPortIndex>
			</RoutedPort>
			<ElementTypes>
				<Type>Short</Type>
			</ElementTypes>
			<ReflectModel>
				<ModelType>ReflectShort</ModelType>
				<SParameterAvailability>Known</SParameterAvailability>
				<Delay>3E-11</Delay>
				<OffsetLoss>2E-09</OffsetLoss>
				<OffsetZ0>50</OffsetZ0>
				<C0>2E-12</C0>
				<C1>1E-22</C1>
				<C2>2E-33</C2>
				<C3>1E-44</C3>
				<ReferenceZ0>50</ReferenceZ0>
			</ReflectModel>
		</CalibrationElement>
		<CalibrationElement>
			<Id>Short-F</Id>
			<Description>Example Short</Description>
			<FrequencyRange>
				<Min>1000000000</Min>
				<Max>99000000000</Max>
			</FrequencyRange>
			<RoutedPort>
				<PhysicalPortId>Short-F_Port0</PhysicalPortId>
				<SParameterPortIndex>0</SParameterPortIndex>
			</RoutedPort>
			<ElementTypes>
				<Type>Short</Type>
			</ElementTypes>
			<ReflectModel>
				<ModelType>ReflectShort</ModelType>
				<SParameterAvailability>Known</SParameterAvailability>
				<Delay>3E-11</Delay>
				<OffsetLoss>2E-09</OffsetLoss>
				<OffsetZ0>50</OffsetZ0>
				<C0>2E-12</C0>
				<C1>1E-22</C1>
				<C2>2E-33</C2>
				<C3>1E-44</C3>
				<ReferenceZ0>50</ReferenceZ0>
			</ReflectModel>
		</CalibrationElement>
		<CalibrationElement>
			<Id>Open-M</Id>
			<Description>Example Open</Description>
			<FrequencyRange>
				<Min>1000000000</Min>
				<Max>99000000000</Max>
			</FrequencyRange>
			<RoutedPort>
				<PhysicalPortId>Open-M_Port0</PhysicalPortId>
				<SParameterPortIndex>0</SParameterPortIndex>
			</RoutedPort>
			<ElementTypes>
				<Type>Open</Type>
			</ElementTypes>
			<ReflectModel>
				<ModelType>ReflectOpen</ModelType>
				<SParameterAvailability>Known</SParameterAvailability>
				<Delay>3E-11</Delay>
				<OffsetLoss>2E-09</OffsetLoss>
				<OffsetZ0>50</OffsetZ0>
				<C0>5E-14</C0>
				<C1>3E-25</C1>
				<C2>2E-35</C2>
				<C3>1E-46</C3>
				<ReferenceZ0>50</ReferenceZ0>
			</ReflectModel>
		</CalibrationElement>
		<CalibrationElement>
			<Id>Open-F</Id>
			<Description>Example Open</Description>
			<FrequencyRange>
				<Min>1000000000</Min>
				<Max>99000000000</Max>
			</FrequencyRange>
			<RoutedPort>
				<PhysicalPortId>Open-F_Port0</PhysicalPortId>
				<SParameterPortIndex>0</SParameterPortIndex>
			</RoutedPort>
			<ElementTypes>
				<Type>Open</Type>
			</ElementTypes>
			<ReflectModel>
				<ModelType>ReflectOpen</ModelType>
				<SParameterAvailability>Known</SParameterAvailability>
				<Delay>3E-11</Delay>
				<OffsetLoss>2E-09</OffsetLoss>
				<OffsetZ0>50</OffsetZ0>
				<C0>5E-14</C0>
				<C1>3E-25</C1>
				<C2>2E-35</C2>
				<C3>1E-46</C3>
				<ReferenceZ0>50</ReferenceZ0>
			</ReflectModel>
		</CalibrationElement>
		<CalibrationElement>
			<Id>Load-M</Id>
			<Description>Example Load</Description>
			<FrequencyRange>
				<Min>1000000000</Min>
				<Max>99000000000</Max>
			</FrequencyRange>
			<RoutedPort>
				<PhysicalPortId>Load-M_Port0</PhysicalPortId>
				<SParameterPortIndex>0</SParameterPortIndex>
			</RoutedPort>
			<ElementTypes>
				<Type>Load</Type>
			</ElementTypes>
			<ReflectModel>
				<ModelType>Load</ModelType>
				<SParameterAvailability>Known</SParameterAvailability>
				<Delay>0</Delay>
				<OffsetLoss>0</OffsetLoss>
				<OffsetZ0>50</OffsetZ0>
				<C0>0</C0>
				<C1>0</C1>
				<C2>0</C2>
				<C3>0</C3>
				<ReferenceZ0>0</ReferenceZ0>
			</ReflectModel>
