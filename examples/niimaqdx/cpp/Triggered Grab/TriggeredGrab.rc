/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_IMAQDX              ICON    DISCARDABLE     "res\\TriggeredGrab.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_TRIGGEREDGRAB_DIALOG DIALOGEX 40, 40, 164, 217
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "NI-IMAQdx Triggered Grab Example"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Camera Name",IDC_STATIC,8,7,46,8
    EDITTEXT        IDC_CAMNAME,8,17,60,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Initialize",ID_INITIALIZE,14,42,48,24
    PUSHBUTTON      "Grab",ID_GRAB,14,66,48,24
    PUSHBUTTON      "Stop",ID_STOP,14,90,48,24
    PUSHBUTTON      "Quit",ID_QUIT,14,114,48,24
    EDITTEXT        IDC_FRAMESPERSEC,8,163,60,14,ES_AUTOHSCROLL
    LTEXT           "Frames per Second",IDC_STATIC,8,152,62,8
    EDITTEXT        IDC_BUFFERNUM,8,195,60,14,ES_AUTOHSCROLL
    LTEXT           "Buffer Number",IDC_STATIC,8,184,46,8
    LTEXT           "Trigger Mode",IDC_STATIC,97,30,43,8
    COMBOBOX        IDC_TRIGGER_MODE,95,42,60,130,CBS_DROPDOWN | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Trigger Activation",IDC_STATIC,95,59,56,8
    COMBOBOX        IDC_TRIGGER_ACTIVATION,95,70,60,110,CBS_DROPDOWN | 
                    CBS_SORT | WS_VSCROLL | WS_TABSTOP
END


