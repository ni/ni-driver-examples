// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_IMAQDX              ICON    DISCARDABLE     "res\\LLSequence.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_LLSEQUENCE_DIALOG DIALOGEX 40, 40, 157, 137
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "NI-IMAQdx Low-Level Sequence Example"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Camera Name",IDC_STATIC,8,7,46,8
    EDITTEXT        IDC_CAMNAME,8,17,60,14,ES_AUTOHSCROLL
    LTEXT           "Number of Images",IDC_STATIC,8,34,58,8
    EDITTEXT        IDC_NB_IMAGES,8,47,60,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Start",ID_START,14,66,48,24
    PUSHBUTTON      "Quit",ID_QUIT,14,90,48,24
    LTEXT           "Displayed Image",IDC_STATIC,86,29,53,8
    CONTROL         "Slider1",IDC_DISPLAYED_IMAGE,"msctls_trackbar32",
                    TBS_AUTOTICKS | TBS_VERT | TBS_BOTH | WS_TABSTOP,88,39,
                    38,82
END


