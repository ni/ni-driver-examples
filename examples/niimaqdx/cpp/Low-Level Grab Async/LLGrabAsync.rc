// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_IMAQDX              ICON    DISCARDABLE     "res\\LLGrabAsync.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_LLGRABASYNC_DIALOG DIALOGEX 40, 40, 82, 185
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "NI-IMAQdx Low-Level Grab Async Example"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Camera Name",IDC_STATIC,8,7,46,8
    EDITTEXT        IDC_CAMNAME,8,17,60,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Grab",ID_GRAB,14,42,48,24
    PUSHBUTTON      "Stop",ID_STOP,14,66,48,24
    PUSHBUTTON      "Quit",ID_QUIT,14,90,48,24
    LTEXT           "Frames per Second",IDC_STATIC,8,122,66,8
    EDITTEXT        IDC_FRAMESPERSEC,8,134,60,14,ES_AUTOHSCROLL
    LTEXT           "Buffer Number",IDC_STATIC,8,154,63,8
    EDITTEXT        IDC_BUFFERNUM,8,164,60,14,ES_AUTOHSCROLL
END


