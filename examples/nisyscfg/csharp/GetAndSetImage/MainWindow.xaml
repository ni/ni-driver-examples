<Window x:Class="NationalInstruments.Examples.GetAndSetImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:SystemConfiguration="clr-namespace:NationalInstruments.SystemConfiguration;assembly=NationalInstruments.SystemConfiguration"
        xmlns:local="clr-namespace:NationalInstruments.Examples.GetAndSetImage"
        Title="Get And Set Image" Height="800" Width="600" Icon="App.ico">
    <Window.Resources>
        <ObjectDataProvider x:Key="networkInterfaceSettingsEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="SystemConfiguration:NetworkInterfaceSettings"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <local:NetworkInterfaceSettingsToStringConverter x:Key="NetworkInterfaceSettingsToStringConverter"/>
    </Window.Resources>

    <Grid Margin="12" Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Expander Grid.Row="0" Header="Operating Instructions" IsExpanded="True" Margin="0,0,0,20">
            <TextBlock xml:space="preserve" TextWrapping="Wrap" Padding="10,4,0,0"><Bold>Overview:</Bold> Obtains an image of a Real-Time (RT) target or reimages an RT target to a saved image.
<Bold>Requirements:</Bold> NI System Configuration
<Bold>Instructions:</Bold>
1. Enter the RT <Bold>Target</Bold>. Enter the <Bold>User Name</Bold> and <Bold>Password</Bold> if necessary.
2. Specify the location of the image.
3. Specify whether to Get or Set the RT image.
4. If getting the image, optionally set the image metadata.
5. If setting the image, specify the <Bold>Network Interface Settings</Bold>.
6. Press <Bold>Get/Set Image</Bold>.</TextBlock>
        </Expander>

        <Grid Grid.Row="1" IsEnabled="{Binding CanBeginGetSetImage}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Target" Margin="0,0,12,0"/>
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Target, Mode=OneWayToSource}" Margin="0,0,12,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="User Name" Margin="0,0,12,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Username, Mode=OneWayToSource}" Margin="0,0,12,0"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Password"/>
            <PasswordBox Name="passwordBox" Grid.Row="1" Grid.Column="2"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Directory"/>
            <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Directory, Mode=OneWayToSource}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0" IsEnabled="{Binding CanBeginGetSetImage}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Content="Get/Set Image" Height="40" Width="160" IsDefault="True" Click="OnGetSetImageClick"/>
            <RadioButton x:Name="getImageButton" Grid.Row="0" Grid.Column="1" GroupName="getSetImage" Content="Get Image" Margin="12,0,0,0" IsChecked="True"/>
            <RadioButton x:Name="setImageButton" Grid.Row="1" Grid.Column="1" GroupName="getSetImage" Content="Set Image" Margin="12,0,0,0" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,20,0,0" IsEnabled="{Binding CanBeginGetSetImage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Image Metadata" Padding="8" Margin="0,0,6,0" IsEnabled="{Binding ElementName=getImageButton, Path=IsChecked}">
                <StackPanel DataContext="{Binding ImageMetadata}">
                    <TextBlock Text="Title" Margin="0,0,0,1"/>
                    <TextBox Margin="0,1,0,2" Text="{Binding Title, Mode=OneWayToSource}"/>
                    <TextBlock Text="ID" Margin="0,2,0,1"/>
                    <TextBox Margin="0,1,0,2" Text="{Binding Id, Mode=OneWayToSource}"/>
                    <TextBlock Text="Version" Margin="0,2,0,1"/>
                    <TextBox Margin="0,1,0,2" Text="{Binding Version, Mode=OneWayToSource}"/>
                    <TextBlock Text="Description" Margin="0,2,0,1"/>
                    <TextBox Margin="0,1,0,2" Text="{Binding Description, Mode=OneWayToSource}"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.Column="1" Margin="6,0,0,0" IsEnabled="{Binding CanBeginGetSetImage}">
                <TextBlock Text="Network Interface Settings"/>
                <ComboBox IsEnabled="{Binding ElementName=setImageButton, Path=IsChecked}" SelectedIndex="0" SelectedItem="{Binding NetworkInterfaceSettings, Mode=OneWayToSource}" ItemsSource="{Binding Source={StaticResource networkInterfaceSettingsEnum}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NetworkInterfaceSettingsToStringConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="4" Margin="0,20,0,0" ItemsSource="{Binding InstalledSoftware}" AutoGenerateColumns="False" IsReadOnly="True" IsEnabled="{Binding CanBeginGetSetImage}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Installed Software" Width="3*" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Version" Width="*" Binding="{Binding Version}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
